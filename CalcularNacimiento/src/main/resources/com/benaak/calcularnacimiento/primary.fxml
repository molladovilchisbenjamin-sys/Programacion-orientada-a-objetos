<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0"
      stylesheets="@styles.css"
      styleClass="root"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.benaak.calcularnacimiento.PrimaryController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Fecha de nacimiento" styleClass="etiqueta" />
            <DatePicker fx:id="dateNacimiento" />
         </children>
      </HBox>

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="CalcularButton" text="Calcular" onAction="#CalcularFecha"/>
            <Button fx:id="LimpiarButton" text="Limpiar" onAction="#LimpiarFecha"/>
         </children>
      </HBox>

      <Label fx:id="lbResultado" text="" styleClass="resultado" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>