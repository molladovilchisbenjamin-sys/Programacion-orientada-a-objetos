<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="450.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.datapars.fabula.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="La Liebre y la Tortuga">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      
      <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#iniciarCarrera" text="Comenzar carrera" />
      
      <Label fx:id="lblLiebre" text="Liebre ready pa las corridas" />
      <ProgressBar fx:id="pbLiebre" prefWidth="300.0" progress="0.0" />
      
      <Label fx:id="lblTortuga" text="Tortuga ready pa las corridas" />
      <ProgressBar fx:id="pbTortuga" prefWidth="300.0" progress="0.0" />
   </children>
</VBox>