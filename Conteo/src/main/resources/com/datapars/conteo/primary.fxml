<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="400.0" spacing="30.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.datapars.conteo.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Contar número de clics" />
      
      <TextField fx:id="txtConteo" editable="false" promptText="0" alignment="CENTER_LEFT" />
      
      <Button fx:id="btnContar" mnemonicParsing="false" onAction="#contarClic" text="¡Contar!" />
      
      <Label text="Esperar 10 segundos" />
      
      <ProgressBar fx:id="progressBar" prefWidth="300.0" progress="0.0" />
      
      <Button fx:id="btnEsperar" mnemonicParsing="false" onAction="#iniciarEspera" text="¡Esperar!" />
   </children>
</VBox>